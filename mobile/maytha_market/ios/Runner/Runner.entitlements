<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: product pages on the store open in the app. The site serves
	     /.well-known/apple-app-site-association once APPLE_TEAM_ID is set in Vercel, and the
	     App ID needs the Associated Domains capability in the Apple developer account. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:maithaloun-sooq.vercel.app</string>
	</array>
</dict>
</plist>
