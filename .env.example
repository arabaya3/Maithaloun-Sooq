DATABASE_URL=postgresql://maithalun_dev:replace_with_local_password@127.0.0.1:5433/maithalun_dev
TEST_DATABASE_URL=postgresql://maithalun_test:replace_with_test_password@127.0.0.1:5434/maithalun_test
POSTGRES_DEV_PASSWORD=replace_with_local_password
POSTGRES_TEST_PASSWORD=replace_with_test_password
ORDER_RATE_LIMIT_PEPPER=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
CRON_SECRET=replace_with_at_least_32_random_characters

# AI_FAKE_MODE=1 swaps AI calls for fixed local fixtures. It is ignored in production.

# TRUST_PROXY=true only when a trusted reverse proxy overwrites
# X-Forwarded-For / X-Real-IP. Never enable it if clients can set those
# headers directly. It is used solely for optional login rate-limit
# network keys, not for authorization.

# Local test-only owner credentials belong in gitignored .env.local:
# TEST_ADMIN_USERNAME=
# TEST_ADMIN_PASSWORD=
ADMIN_ASSISTANT=off
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini

# ADMIN_ASSISTANT: off | read | full. The assistant is owner-only; full allows confirmed changes.
# ASSISTANT_SMOKE_TEST=on opens the owner-only read-only smoke page (/admin/assistant-smoke). Keep it off;
# enable briefly to check the configured model, then remove it.
ASSISTANT_SMOKE_TEST=off
# Real-model evaluation (local test database only): ASSISTANT_MODEL_EVAL=1 pnpm test:assistant:model
# Optional: ASSISTANT_EVAL_TOKEN_BUDGET, ASSISTANT_EVAL_COST_BUDGET_USD, ASSISTANT_EVAL_ONLY=case-id,...
# ASSISTANT_EVAL_PRICE_INPUT / _CACHED / _OUTPUT (USD per million tokens) when the model is not priced in code.

# Optional customer accounts (phone OTP through Supabase Auth). Keep off until an SMS
# provider is configured in Supabase Auth > Providers > Phone.
CUSTOMER_ACCOUNTS=off
CUSTOMER_OTP_PROVIDER=supabase
# Local development only; refused in production builds.
# CUSTOMER_OTP_PROVIDER=development
# CUSTOMER_OTP_DEV_CODE=246810

# Facebook manager (/admin/social). Off unless SOCIAL_MANAGER=on; see docs/social-manager.md.
SOCIAL_MANAGER=off
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_KEY=
# The storefront address printed in captions and images.
SOCIAL_PUBLIC_ORIGIN=https://maithaloun-sooq.vercel.app
# Optional: read products from another deployment's public catalog (previews, local).
# SOCIAL_CATALOG_ORIGIN=https://maithaloun-sooq.vercel.app
SOCIAL_PAGE_ID=61595987361563
# Facebook Login for Business configuration id (replaces the scope list when set).
META_LOGIN_CONFIG_ID=
# Meta app for Facebook Login and token checks (never a Facebook password).
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v25.0
# SOCIAL_AI_CAPTIONS=on rewrites template captions with OPENAI_TEXT_MODEL; the caption guard still applies.
SOCIAL_AI_CAPTIONS=off
# FFMPEG_PATH=ffmpeg
# Publisher for approved posts: meta (direct Graph API, default) or make (Make.com scenario).
SOCIAL_PUBLISHER=meta
# Make.com custom webhook (server-only; never NEXT_PUBLIC). The key is sent as x-make-apikey.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
# on only after the Make scenario is confirmed to publish Reels.
MAKE_SUPPORTS_REELS=off
# Shared secret (>= 32 chars) the scenario sends as x-maytha-callback-key to /api/social/make/callback.
MAKE_CALLBACK_SECRET=
