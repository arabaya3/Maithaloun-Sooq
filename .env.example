TEST_DATABASE_URL=postgresql://maithalun_test:replace_with_test_password@127.0.0.1:5434/maithalun_test
POSTGRES_DEV_PASSWORD=replace_with_local_password
POSTGRES_TEST_PASSWORD=replace_with_test_password
ORDER_RATE_LIMIT_PEPPER=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
CRON_SECRET=replace_with_at_least_32_random_characters

# AI_FAKE_MODE=1 swaps AI calls for fixed local fixtures. It is ignored in production.

# TRUST_PROXY=true only when a trusted reverse proxy overwrites
# X-Forwarded-For / X-Real-IP. Never enable it if clients can set those
# headers directly. It is used solely for optional login rate-limit
# network keys, not for authorization.

# Local test-only owner credentials belong in gitignored .env.local:
# TEST_ADMIN_USERNAME=
# TEST_ADMIN_PASSWORD=
